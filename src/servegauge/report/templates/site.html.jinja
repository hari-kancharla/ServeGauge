<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'">
  <title>{{ title }} · ServeGauge</title>
  <meta name="description" content="Recorded endpoint evidence, uncertainty, methods and replay links. A local selection, not a provider ranking.">
  <link rel="stylesheet" href="{{ prefix }}assets/site.css"><script src="{{ prefix }}assets/site.js" defer></script>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23186354'/%3E%3Cpath d='M8 23V16M16 23V9M24 23V13' stroke='white' stroke-width='3'/%3E%3C/svg%3E">
</head>
<body>
<a class="skip" href="#main">Skip to evidence</a>
<header><a class="brand" href="{{ prefix }}index.html">▥ ServeGauge</a><nav aria-label="Site sections"><a href="{{ prefix }}index.html">Endpoints</a><a href="{{ prefix }}timeline.html">History</a><a href="{{ prefix }}validation.html">Validation</a><a href="{{ prefix }}methods.html">Methods</a><a href="{{ prefix }}replies.html">Right of reply</a></nav><label class="appearance">Appearance<select id="appearance" aria-label="Appearance"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label></header>
<main id="main">
<p class="eyebrow">Recorded inference evidence / local build</p><h1>{{ title }}</h1>
<p class="lead">{{ scope }}</p><p class="scope">Content-removed artifacts. Publication is not enabled by building or previewing this site. Results apply to their recorded probes, references and sampling settings.</p>
{% macro counts(values) %}{% for key,value in values|dictsort %}<span class="outcome {{ key|lower }}">{{ value }} {{ key }}</span> {% endfor %}{% endmacro %}
{% macro check_table(rows, caption) %}
<div class="table-wrap" tabindex="0" role="region" aria-label="{{ caption }} - scroll horizontally for all statistics"><table class="checks"><caption>{{ caption }}</caption><thead><tr><th>Check / class</th><th>Outcome</th><th>n</th><th>Estimate / interval</th><th>Delta / interval</th><th>Reference</th><th>Margin / adjusted p</th><th>Reason</th></tr></thead><tbody>{% for c in rows %}<tr><th scope="row">{{ c.check_id }}<small>{{ c.suite_id }} / {{ c.check_class }}</small></th><td>{{ c.verdict_label }}</td><td>{{ c.n }}</td><td>{{ c.estimate_text }}<small>{{ c.interval_text }}</small></td><td>{{ c.delta_text }}<small>{{ c.delta_interval_text }}</small></td><td>{{ c.reference_tier }}<small>{{ c.reference_text }}</small></td><td>{{ c.margin_text }}<small>{{ c.adjusted_p_text }}</small></td><td>{{ c.reason }}</td></tr>{% endfor %}</tbody></table></div>
{% endmacro %}
{% if page in ['index','model'] %}
<section><div class="heading"><h2>Provider / suite matrix</h2><span>{{ run_count }} selected run{% if run_count != 1 %}s{% endif %}; each row is one endpoint capture</span></div>
{% if endpoints %}
<label class="model-control" for="model-filter">Model <select id="model-filter" aria-label="Model"><option value="all">All recorded models</option>{% for model in models %}<option value="{{ model.id }}"{% if page == 'model' and model.id == selected_model %} selected{% endif %}>{{ model.id }}</option>{% endfor %}</select></label>
<p class="model-links">Script-free model views: {% for model in models %}<a href="{{ prefix }}{{ model.href }}">{{ model.id }}</a> {% endfor %}</p>
<p id="visible-count" role="status" aria-live="polite">Selected captures below; no cross-run pooling.</p>
<div class="table-wrap" tabindex="0" role="region" aria-label="Provider and suite matrix"><table><caption>Exact check counts by endpoint and recorded run; no ranking</caption><thead><tr><th>Endpoint / declared model</th><th>Run / date</th><th>Recorded outcomes</th><th>Suites</th><th>Evidence</th></tr></thead><tbody>{% for e in endpoints %}<tr class="endpoint-row" data-model="{{ e.model }}"{% if page == 'model' and e.model != selected_model %} hidden{% endif %}><th scope="row"><a href="{{ prefix }}{{ e.href }}">{{ e.endpoint_id }}</a><small>{{ e.model }} / {{ e.profile }}</small><small>{{ 'Scripted mock' if e.synthetic_mock else 'Recorded endpoint' }}</small></th><td>{{ e.run_id }}<small>{{ e.captured_at }}</small></td><td>{{ counts(e.counts) }}</td><td>{% for s in e.suites %}<div class="suite"><strong>{{ s.id }}</strong> {{ counts(s.counts) }}</div>{% endfor %}</td><td><a href="{{ prefix }}{{ e.report_href }}">Full numeric report and bundles</a></td></tr>{% endfor %}</tbody></table></div>
{% else %}<div class="empty"><h3>No recorded runs selected</h3><p>Build again into a fresh directory with <code>servegauge site build --run RUN_ID --out reports/my-site</code>. Only explicitly selected sealed captures are included.</p></div>{% endif %}
</section>
{% elif page == 'endpoint' %}
<section><h2>Recorded capture</h2><dl class="facts"><div><dt>Declared model / profile</dt><dd>{{ endpoint.model }} / {{ endpoint.profile }}</dd></div><div><dt>Run</dt><dd>{{ endpoint.run_id }}</dd></div><div><dt>Captured</dt><dd>{{ endpoint.captured_at }}</dd></div><div><dt>Evidence kind</dt><dd>{{ 'Scripted mock' if endpoint.synthetic_mock else 'Recorded endpoint' }}</dd></div></dl><p>{{ counts(endpoint.counts) }}</p><p><a href="{{ prefix }}{{ endpoint.report_href }}">Open full report, alternatives, falsifiers and local evidence bundles →</a></p></section>
<section><h2>Capability matrix</h2>{% if endpoint.capabilities %}{{ check_table(endpoint.capabilities, 'Observed capability probes, not deployment guarantees') }}{% else %}<p>No capability probes in this capture.</p>{% endif %}</section>
<section><h2>Fingerprint position</h2><p>Recorded position is descriptive. Overlapping bands, unavailable methods and qualification limits remain explicit; no weight or hardware certification.</p>{% if endpoint.fingerprints %}<div class="table-wrap" tabindex="0" role="region" aria-label="Recorded fingerprint bands"><table><caption>Recorded method positions and different-model controls</caption><thead><tr><th>Method / outcome</th><th>n / estimate</th><th>Delta interval / noise</th><th>Position / different band</th><th>Controls</th></tr></thead><tbody>{% for f in endpoint.fingerprints %}<tr><th scope="row">{{ f.check_id }}<small>{{ f.verdict }}</small></th><td>{{ f.n }} / {{ f.estimate_text }}</td><td>{{ f.delta_interval_text }}<small>Noise {{ f.noise_text }}</small></td><td>{{ f.position }}<small>{{ f.different_text }}</small></td><td>{% for c in f.controls %}<div>{{ c.model }}: {{ c.position }}<small>{{ c.band }}</small></div>{% else %}unavailable{% endfor %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p>No fingerprint measurements in this capture.</p>{% endif %}</section>
<section><h2>Audit cost and capture coverage</h2><dl class="facts"><div><dt>Known final-record charge subtotal (USD)</dt><dd>{{ endpoint.cost.reported_usd if endpoint.cost.reported_usd is not none else 'unavailable' }}</dd></div><div><dt>Known-charge / sent records</dt><dd>{{ endpoint.cost.known_records }} / {{ endpoint.cost.sent_records }}</dd></div><div><dt>Recorded attempts / unsent rows</dt><dd>{{ endpoint.cost.attempts }} / {{ endpoint.cost.unsent_records }}</dd></div></dl><p>Known provider/generation charges only. Estimates are excluded; retries and unknown charges may be omitted from this subtotal. No invoice verification or price extrapolation. Check B04 in the full report for qualified all-attempt comparisons.</p></section>
<section><h2>Complete check cards</h2>{{ check_table(endpoint.checks, 'Recorded check witnesses; missing values remain unavailable') }}</section>
{% elif page == 'methods' %}
<p><a href="methods.md" download>Download the original methods text</a></p>{% for s in sections %}<section class="document"><h2>{{ s.heading }}</h2><div class="document-copy">{{ s.text }}</div></section>{% endfor %}
{% elif page == 'validation' %}
<section><h2>Scoped historical acceptance</h2><p>These are selected local receipt summaries and content hashes, not a new qualification of these captures. Synthetic, offline, provider and hardware evidence have different scopes. Read the methods and retained repository receipts before interpreting a pass.</p><div class="table-wrap" tabindex="0" role="region" aria-label="Validation receipt summaries"><table><caption>Available source-bound validation receipts</caption><thead><tr><th>Receipt</th><th>Recorded scope</th><th>Tests at snapshot</th><th>Content hash</th></tr></thead><tbody>{% for v in validation %}<tr><th scope="row">{{ v.name }}</th><td>{{ v.scope }}</td><td>{{ v.tests if v.tests is not none else 'unavailable' }}</td><td class="hash">{{ v.sha256 }}</td></tr>{% else %}<tr><td colspan="4">No curated local validation receipts supplied.</td></tr>{% endfor %}</tbody></table></div><p><a href="validation.json" download>Download these receipt summaries</a></p></section>
{% elif page == 'timeline' %}
<section><h2>Recorded change events</h2><p>These contrasts come from sealed monitor records. Each retains its original proof and declared scope. This page does not requalify a capture or infer a change from two ordinary quality cards.</p>
{% if monitor_events %}<ol class="event-list">{% for e in monitor_events %}<li class="event-card" id="{{ e.event_id }}">
<div class="heading"><h3>{{ e.endpoint_id }}</h3><span class="outcome">Recorded {{ e.reference_tier }} scope</span></div>
<p class="observation-time">Observation interval (UTC): {{ e.contrast.observation_start }} → {{ e.contrast.observation_end }}</p>
<dl class="event-facts"><div><dt>First-attempt successes before</dt><dd>{{ e.contrast.left_successes }} / {{ e.contrast.left_n }}</dd></div><div><dt>After</dt><dd>{{ e.contrast.right_successes }} / {{ e.contrast.right_n }}</dd></div><div><dt>Success-rate difference</dt><dd>{{ e.difference_text }}</dd></div><div><dt>Fixed-family interval</dt><dd>{{ e.interval_text }}</dd></div></dl>
<p class="event-scope">Quality verdict: <strong>{{ e.quality_verdict }}</strong>. Scope: {{ e.interval_scope }}. The interval applies to the declared independent mock process; it does not establish a cause, precise change time or provider reliability.</p>
<details><summary>Retained event and proof</summary><dl class="proof-details"><dt>Event</dt><dd>{{ e.event_id }}</dd><dt>Qualification</dt><dd>{{ e.qualification.id }}</dd><dt>Receipt SHA-256</dt><dd>{{ e.qualification.sha256 }}</dd><dt>Input runs</dt><dd>{% for run in e.run_ids %}<div>{{ run }}</div>{% endfor %}</dd></dl></details>
</li>{% endfor %}</ol><p class="event-scope">Displayed percentages are rounded; exact estimates, counts and bounds remain in the numeric index. The confidence scope is a fixed declared family, not all future years or coverage conditional on selecting an alarm.</p>
{% else %}<div class="empty"><h3>No calibrated change events in this selection</h3><p>No complete sealed event is attached to all of its selected input runs. Missing events do not establish stability, and differences between ordinary captures are not change detections.</p></div>{% endif %}
</section>
<section><h2>Selected capture history</h2><div class="table-wrap" tabindex="0" role="region" aria-label="Recorded capture history"><table><caption>Individual selected captures; no cross-run quality pooling</caption><thead><tr><th>Recorded date</th><th>Endpoint / run</th><th>Evidence</th></tr></thead><tbody>{% for e in endpoints|sort(attribute='captured_at') %}<tr><td>{{ e.captured_at }}</td><th scope="row">{{ e.endpoint_id }}<small>{{ e.run_id }}</small></th><td><a href="{{ e.href }}">Capture card</a></td></tr>{% else %}<tr><td colspan="3">No recorded runs selected.</td></tr>{% endfor %}</tbody></table></div></section>
{% elif page == 'replies' %}
<section><h2>Owner assertions and right of reply</h2><p>This site sends no communication. The records below are local owner assertions; delivery and public-source status are <strong>not independently verified</strong>. Publication policy is rechecked against current failure evidence and notice records before an owner publication preflight.</p>
<p class="event-scope">Snapshot time (UTC): {{ publication_as_of }}. A draft starts no waiting period. A reply keeps the original send clock; changed evidence cannot inherit an earlier version's eligibility.</p>
{% for note in reply_notes %}<article class="event-card"><div class="heading"><h3>{{ note.endpoint_id }} · {{ note.check_id }}</h3><span class="outcome">{{ 'Scripted mock' if note.synthetic_mock else 'Owner record required' }}</span></div>
<p class="observation-time">Run {{ note.run_id }}</p>
<p><strong>{{ 'Notice policy satisfied at snapshot' if note.state.eligible else 'Publication notice gate remains blocked' }}</strong><small>Basis: {{ note.state.basis }} · Delivery verified: no</small></p>
{% if note.earlier_revisions %}<p>{{ note.earlier_revisions }} earlier notice revision(s) do not satisfy the current evidence version.</p>{% endif %}
{% if note.assertions %}<div class="table-wrap" tabindex="0" role="region" aria-label="Owner assertion history"><table><caption>Owner assertions for this exact failure revision</caption><thead><tr><th>Assertion</th><th>Claimed time (UTC)</th><th>Private reference SHA-256</th><th>Provenance</th></tr></thead><tbody>{% for record in note.assertions %}<tr><th scope="row">{{ record.type }}</th><td>{{ record.at }}</td><td class="hash">{{ record.reference_sha256 }}</td><td>Owner assertion; delivery unverified</td></tr>{% endfor %}</tbody></table></div>{% else %}<p>No owner assertions for this exact revision. No send or elapsed waiting period is implied.</p>{% endif %}
</article>{% else %}<div class="empty"><h3>No selected failure notice records</h3><p>No owner contact or waiting period is implied. A complete current failure revision and its local evidence bundle are required before recording a notice.</p></div>{% endfor %}
<p>A successful local policy preflight remains distinct from owner approval to publish. No upload, contact or hosted schedule follows this build.</p></section>
{% endif %}
<section class="downloads"><h2>Data and limits</h2><p><a href="{{ prefix }}site.json" download>Download selected numeric index</a> · <a href="{{ prefix }}methods.html">Methods and limits</a></p><p>Content removal is not anonymity. Public identifiers and numeric witnesses remain. Missing/inconclusive evidence does not establish that an endpoint is fault-free.</p></section>
</main><footer>ServeGauge · Local recorded evidence. No certification of weights, hardware, quantization or intent.</footer>
</body></html>
